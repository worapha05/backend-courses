{
  "ConnectionStrings": {
    "Default": "Data Source=catalog-lab.db"
  },
  "Jwt": {
    "Issuer": "catalog-lab",
    "Audience": "catalog-lab-clients",
    "Key": "DEV_ONLY_CATALOG_LAB_SECRET_KEY_MUST_BE_LONG",
    "ExpiryHours": 8
  },
  "Cors": {
    "Origins": ["http://localhost:3000", "http://localhost:5173"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
